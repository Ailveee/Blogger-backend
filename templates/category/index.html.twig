{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="m-0">Categories</h2>
            <a href="{{ path('app_category_new') }}" class="btn btn-primary">+ New Category</a>
        </div>

        {% if categories is empty %}
            <div class="alert alert-info">No categories found.</div>
        {% else %}
            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ category.name }}</h5>
                                <p class="card-text text-muted">
                                    {{ category.description ?: 'No description provided.' }}
                                </p>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <div>
                                        <a href="{{ path('app_category_show', {id: category.id}) }}" class="btn btn-sm btn-outline-secondary">View</a>
                                        <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                    </div>
                                    <span class="badge bg-secondary">{{ category.articles|length }} articles</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
