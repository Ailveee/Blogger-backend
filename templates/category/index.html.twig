{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="m-0">Categories</h2>
            <a href="{{ path('app_category_new') }}" class="btn btn-primary">+ New Category</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
{#                        <th>ID</th>#}
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for category in categories %}
                        <tr>
{#                            <td>{{ category.id }}</td>#}
                            <td>{{ category.name }}</td>
                            <td>{{ category.description }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_category_show', {id: category.id}) }}"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                                <a href="{{ path('app_category_edit', {id: category.id}) }}"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center p-4">No categories found.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
{% endblock %}
