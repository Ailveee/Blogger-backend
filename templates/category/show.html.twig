{% extends 'base.html.twig' %}

{% block title %}Category Details{% endblock %}

{% block body %}
    <div class="container py-5">

        <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary mb-4">← Back</a>

        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="mb-4">{{ category.name }}</h3>

                <dl class="row">
{#                    <dt class="col-sm-3">ID</dt>#}
{#                    <dd class="col-sm-9">{{ category.id }}</dd>#}

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">{{ category.description }}</dd>
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn btn-primary">Edit</a>
                    {{ include('category/_delete_form.html.twig') }}
                </div>
            </div>
        </div>

    </div>
{% endblock %}
