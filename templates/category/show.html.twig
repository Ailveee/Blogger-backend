{% extends 'base.html.twig' %}

{% block title %}Category: {{ category.name }}{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="m-0">Category: {{ category.name }}</h2>
            <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn btn-outline-primary">Edit Category</a>
        </div>

        {% if category.description %}
            <div class="mb-4">
                <p class="text-muted">{{ category.description }}</p>
            </div>
        {% endif %}

        <h4 class="mb-3">Articles in this category</h4>

        {% if category.articles is empty %}
            <p>No articles found in this category.</p>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {% for article in category.articles %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ article.title }}</h5>
                                <p class="card-text text-truncate">{{ article.content|slice(0, 150) ~ '...' }}</p>
                                <div class="mt-auto">
                                    <small class="text-muted">
                                        By <a href="{{ path('app_profile_show', {id: article.author.id}) }}">
                                            {{ article.author.name }}
                                        </a> |
                                        {{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '-' }}
                                    </small>
                                    <div class="mt-2">
                                        {% for cat in article.categories %}
                                            <span class="badge bg-secondary">{{ cat.name }}</span>
                                        {% endfor %}
                                    </div>
                                    <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-primary mt-3">Read More</a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
