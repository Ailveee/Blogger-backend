<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Panel{% endblock %}</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Optional Global Styles -->
    <style>
        body {
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            background-color: #f8f9fa;
        }
        #sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: #343a40;
            color: #fff;
            transition: all 0.3s;
        }
        #sidebar a {
            color: #fff;
            text-decoration: none;
        }
        #sidebar a:hover {
            background-color: #495057;
        }
        #content {
            flex: 1;
            padding: 2rem;
        }
        .sidebar-header {
            padding: 1rem;
            font-size: 1.2rem;
            text-align: center;
            background: #212529;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- Sidebar -->
<div id="sidebar" class="d-flex flex-column vh-100">
    <div class="sidebar-header">
        📰 MyBlog Admin
    </div>
    <ul class="nav flex-column mt-3">
        <li class="nav-item">
            <a class="nav-link py-2 px-3" href="{{ path('admin_dashboard') }}">Dashboard</a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-3" href="{{ path('admin_user_index') }}">Users</a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-3" href="{{ path('admin_article_index') }}">Articles</a>
        </li>
        <li class="nav-item">
            <a class="nav-link py-2 px-3" href="{{ path('admin_category_index') }}">Categories</a>
        </li>
        <li class="nav-item mt-auto">
            <a class="nav-link py-2 px-3 text-danger" href="{{ path('app_logout') }}">Logout</a>
        </li>
    </ul>
</div>

<!-- Content -->
<div id="content">
    {% block body %}{% endblock %}
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
