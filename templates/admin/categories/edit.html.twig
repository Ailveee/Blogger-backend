{% extends 'admin/base.html.twig' %}
{% block title %}Edit Category{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1>Edit Category</h1>
        <a href="{{ path('admin_category_index') }}" class="btn btn-outline-secondary mb-4">← Back</a>
        <div class="card shadow-sm p-4">
            {{ form_start(form) }}
            <div class="mb-3">{{ form_label(form.name) }}{{ form_widget(form.name, {'attr': {'class':'form-control'}}) }}{{ form_errors(form.name) }}</div>
            <div class="mb-3">{{ form_label(form.description) }}{{ form_widget(form.description, {'attr': {'class':'form-control', 'rows':3}}) }}{{ form_errors(form.description) }}</div>
            <button class="btn btn-primary">Save Changes</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
