{% extends 'admin/base.html.twig' %}
{% block title %}Categories{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Categories</h1>
            <a href="{{ path('admin_category_new') }}" class="btn btn-primary">
                + New Category
            </a>
        </div>

        <div class="row g-3">
            {% for category in categories %}
                <div class="col-md-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">{{ category.name }}</h5>

                            <p class="card-text text-truncate">
                                {{ category.description ?: 'No description' }}
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center gap-1">
                                <a href="{{ path('admin_category_show', {id: category.id}) }}"
                                   class="btn btn-sm btn-outline-info">
                                    View
                                </a>

                                <a href="{{ path('admin_category_edit', {id: category.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                {{ include('admin/categories/_delete_form.html.twig', {
                                    category: category
                                }) }}
                            </div>

                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5 text-muted">
                    No categories found.
                </div>
            {% endfor %}
        </div>

    </div>
{% endblock %}
