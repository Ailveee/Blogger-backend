{% extends 'admin/base.html.twig' %}
{% block title %}Users{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Categories</h1>
            <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
                + New User
            </a>
        </div>
        <h1 class="mb-4">Users</h1>

        <table class="table table-hover shadow-sm align-middle">
            <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.name }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                        <form action="{{ path('admin_user_delete', {id: user.id}) }}" method="POST" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this user?')">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center py-3">No users found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
