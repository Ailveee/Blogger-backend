{% extends 'admin/base.html.twig' %}

{% block title %}Admin - Articles{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Articles</h2>
            <a href="{{ path('admin_article_new') }}" class="btn btn-primary">+ New Article</a>
        </div>

        {% if articles is empty %}
            <p class="text-center">No articles found.</p>
        {% else %}
            <div class="row g-3">
                {% for article in articles %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ article.title }}</h5>
                                <p class="card-text text-truncate">{{ article.content|slice(0, 100) ~ '...' }}</p>
                                <p class="mb-2">
                                    <small>By {{ article.author.name }} | {{ article.createdAt ? article.createdAt|date('Y-m-d') : '-' }}</small>
                                </p>
                                <div class="mt-auto d-flex justify-content-between">
                                    <a href="{{ path('admin_article_show', {id: article.id}) }}" class="btn btn-sm btn-outline-secondary">View</a>
                                    <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form action="{{ path('admin_article_delete', {id: article.id}) }}" method="POST" onsubmit="return confirm('Are you sure?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
