{% extends 'admin/base.html.twig' %}

{% block title %}Article Details{% endblock %}

{% block body %}
    <div class="container py-5">
        <h2>{{ article.title }}</h2>
        <p class="text-muted">By {{ article.author.name }} | {{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '-' }}</p>
        <p>{{ article.content }}</p>

        <h5>Categories:</h5>
        {% for category in article.categories %}
            <span class="badge bg-secondary">{{ category.name }}</span>
        {% else %}
            <span>-</span>
        {% endfor %}

        <div class="mt-3">
            <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-primary">Edit</a>
            <a href="{{ path('admin_article_index') }}" class="btn btn-secondary">Back</a>
        </div>
    </div>
{% endblock %}
