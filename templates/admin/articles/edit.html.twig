{% extends 'admin/base.html.twig' %}
{% block title %}Edit Article{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1>Edit Article</h1>
        <div class="card shadow-sm p-4">
            {{ form_start(form) }}
            <div class="mb-3">{{ form_label(form.title) }}{{ form_widget(form.title, {'attr': {'class':'form-control'}}) }}{{ form_errors(form.title) }}</div>
            <div class="mb-3">{{ form_label(form.content) }}{{ form_widget(form.content, {'attr': {'class':'form-control', 'rows':5}}) }}{{ form_errors(form.content) }}</div>
            <div class="mb-3">{{ form_label(form.categories) }}{{ form_widget(form.categories) }}{{ form_errors(form.categories) }}</div>
            <button class="btn btn-primary">Save Changes</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
