{% extends 'base.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="mb-4 text-center">All Articles</h1>

        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('app_article_new') }}" class="btn btn-success">Create New Article</a>
        </div>

        {% if articles is empty %}
            <p class="text-center text-muted">No articles available.</p>
        {% else %}
            <div class="row g-4">
                {% for article in articles %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ article.title }}</h5>
                                <p class="card-text text-truncate">{{ article.content|slice(0, 150) ~ '...' }}</p>

                                <p class="mb-1 text-muted small">
                                    By
                                    <a href="{{ path('app_user_profile', {id: article.author.id}) }}" class="text-decoration-none">
                                        {{ article.author.name }}
                                    </a> |
                                    {{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '-' }}
                                </p>

                                <p>
                                    {% for category in article.categories %}
                                        <span class="badge bg-secondary">{{ category.name }}</span>
                                    {% else %}
                                        <span class="text-muted">No categories</span>
                                    {% endfor %}
                                </p>

                                <div class="mt-auto d-flex justify-content-between">
                                    <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-primary btn-sm">Read More</a>

                                    {% if article.author == app.user %}
                                        <div>
                                            <a href="{{ path('app_article_edit', {id: article.id}) }}" class="btn btn-warning btn-sm">Edit</a>

                                            <form method="post" action="{{ path('app_article_delete', {id: article.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                                <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
