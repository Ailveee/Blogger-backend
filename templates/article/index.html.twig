{% extends 'base.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Articles</h1>
        <a href="{{ path('app_article_new') }}" class="btn btn-primary mb-3">Create New</a>

        {% if articles is empty %}
            <p>No articles available.</p>
        {% else %}
            <table class="table table-bordered">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Categories</th>
                    <th>Author</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.id }}</td>
                        <td>{{ article.title }}</td>
                        <td>
                            {% for category in article.categories %}
                                <span class="badge bg-secondary">{{ category.name }}</span>
                            {% else %}
                                -
                            {% endfor %}
                        </td>
                        <td>{{ article.author.name }}</td>
                        <td>{{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-info">Show</a>
                            <a href="{{ path('app_article_edit', {id: article.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
