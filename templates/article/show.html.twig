{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <h1>{{ article.title }}</h1>

    <p>
        By {{ article.author.name }} · {{ article.createdAt|date('Y-m-d H:i') }}
    </p>

    <p>
        {% for category in article.categories %}
            <span class="badge bg-secondary">{{ category.name }}</span>
        {% endfor %}
    </p>

    <div class="mb-4">{{ article.content|nl2br }}</div>

    <p>❤️ {{ article.likedBy|length }} likes</p>

    {% if app.user %}
        <form method="post" action="{{ path('app_article_like', {id: article.id}) }}">
            <button class="btn btn-outline-primary">
                {% if article.likedBy.contains(app.user) %}Unlike{% else %}Like{% endif %}
            </button>
        </form>

        <form method="post" action="{{ path('app_article_share', {id: article.id}) }}" class="mt-2">
            <button class="btn btn-outline-success">Share</button>
        </form>
    {% endif %}
{% endblock %}
