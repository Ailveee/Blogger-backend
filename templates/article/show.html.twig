{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ article.title }}</h1>
        <p>By {{ article.author.name }} | {{ article.createdAt|date('Y-m-d H:i') }}</p>

        <p>
            {% for category in article.categories %}
                <span class="badge bg-secondary">{{ category.name }}</span>
            {% else %}
                No categories
            {% endfor %}
        </p>

        <div class="mb-3">{{ article.content|nl2br }}</div>

        <p>Likes: {{ article.likedBy|length }}</p>

        <form action="{{ path('app_article_like', {id: article.id}) }}" method="post">
            <button type="submit" class="btn btn-primary">
                {% if app.user and article.likedBy.contains(app.user) %}
                    Unlike
                {% else %}
                    Like
                {% endif %}
            </button>
        </form>

        <a href="{{ path('app_home') }}" class="btn btn-link mt-3">Back to Home</a>
    </div>
{% endblock %}
