{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <div class="container my-5">

        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title">{{ article.title }}</h1>

                <div class="mb-3 text-muted">
                    By <a href="{{ path('app_profile', {id: article.author.id}) }}">
                        {{ article.author.name }}
                    </a>
                    | Categories:
                    {% for category in article.categories %}
                        <span class="badge bg-secondary">{{ category.name }}</span>
                    {% else %}
                        -
                    {% endfor %}
                    | {{ article.createdAt ? article.createdAt|date('Y-m-d H:i') : '-' }}
                </div>

                <p class="card-text">{{ article.content }}</p>

                <div class="d-flex gap-2 mt-4">
                    <form action="{{ path('app_article_like', {id: article.id}) }}" method="post">
                        <button type="submit" class="btn btn-outline-danger">
                            {% if app.user and article.likedBy.contains(app.user) %}
                                ❤️ Unlike
                            {% else %}
                                🤍 Like
                            {% endif %}
                            ({{ article.likedBy|length }})
                        </button>
                    </form>

                    <form action="{{ path('app_article_share', {id: article.id}) }}" method="post">
                        <button type="submit" class="btn btn-outline-primary">
                            🔁 Share ({{ article.sharedBy|length }})
                        </button>
                    </form>

                    {% if app.user and app.user == article.author %}
                        <a href="{{ path('app_article_edit', {id: article.id}) }}" class="btn btn-warning">Edit</a>
                        <form action="{{ path('app_article_delete', {id: article.id}) }}" method="post" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
