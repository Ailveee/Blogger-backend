{% extends 'base.html.twig' %}

{% block title %}{{ user.name }}'s Profile{% endblock %}

{% block body %}
    <div class="container py-5">

        <h2>{{ user.name }}'s Profile</h2>
        <hr>

        <h4>📝 Articles</h4>
        <div class="row g-4 mb-4">
            {% for article in user.createdArticles %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ article.title }}</h5>
                            <p class="card-text text-truncate" style="max-height: 4rem;">
                                {{ article.content }}
                            </p>
                            <div class="mt-auto">
                                <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-primary">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>No articles written.</p>
            {% endfor %}
        </div>

        <h4>❤️ Liked Articles</h4>
        <div class="row g-4 mb-4">
            {% for article in user.likedArticles %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ article.title }}</h5>
                            <div class="mt-auto">
                                <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-outline-danger">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>No liked articles.</p>
            {% endfor %}
        </div>

        <h4>🔁 Shared Articles</h4>
        <div class="row g-4">
            {% for article in user.sharedArticles %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ article.title }}</h5>
                            <div class="mt-auto">
                                <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>No shared articles.</p>
            {% endfor %}
        </div>

    </div>
{% endblock %}
