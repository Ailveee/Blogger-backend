{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div class="container py-5">

        <h1 class="mb-4">Latest Articles</h1>

        {% if articles is empty %}
            <div class="alert alert-info">No articles available.</div>
        {% else %}
            <div class="row g-4">
                {% for article in articles %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ article.title }}</h5>
                                <p class="card-text text-truncate" style="max-height: 5rem;">
                                    {{ article.content }}
                                </p>
                                <div class="mt-auto d-flex justify-content-between align-items-center flex-wrap">
                                    <small class="text-muted">
                                        <a href="{{ path('app_profile', {id: article.author.id}) }}">
                                            {{ article.author.name }}
                                        </a>
                                        | {{ article.createdAt|date('Y-m-d') }}
                                    </small>
                                    <div>
                                        {% for category in article.categories %}
                                            <span class="badge bg-secondary">{{ category.name }}</span>
                                        {% endfor %}
                                    </div>
                                </div>
                                <a href="{{ path('app_article_show', {id: article.id}) }}" class="btn btn-sm btn-primary mt-3">Read More</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
