<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    {% block stylesheets %}
        <style>
            /* Global reset */
            *, *::before, *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Arial, sans-serif;
            }

            body {
                background: #121212; /* DARK clean background */
                color: #e0e0e0; /* Soft white */
                min-height: 100vh;
                padding: 40px 20px;
            }

            a {
                color: #4da3ff;
            }

            .container {
                max-width: 500px;
                margin: auto;
                background: #1e1e1e;
                padding: 30px 25px;
                border-radius: 10px;
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
            }

            input, select, textarea {
                width: 100%;
                padding: 12px;
                border: none;
                border-radius: 8px;
                margin-bottom: 15px;
                background: #2b2b2b;
                color: #fff;
            }

            button {
                width: 100%;
                padding: 12px;
                background: #4da3ff;
                border: none;
                border-radius: 8px;
                color: #000;
                font-weight: bold;
                cursor: pointer;
                transition: 0.2s ease-in-out;
            }

            button:hover {
                background: #74b8ff;
            }
        </style>
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body>
{% block body %}{% endblock %}
</body>
</html>
